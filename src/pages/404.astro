---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="Esta página no existe o cambió de dirección.">
  <div class="signboard">
    <div class="wrapper pb-16 pt-12 sm:pb-24 sm:pt-20">
      <h1 class="headline headline-xl">Por aquí no hay camino</h1>
      <p class="mt-5 max-w-[34rem] text-lg font-medium text-olive">
        La página que buscas no existe o cambió de dirección. Desde el catálogo llegas a todo lo que hay en la tienda.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/catalogo" class="button">Ver el catálogo</a>
        <a href="/" class="button button-light">Ir al inicio</a>
      </div>
    </div>
  </div>
</Base>
