---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="Esta página no existe o cambió de dirección.">
  <div class="hex-bg border-b border-carbon-700 bg-carbon-950">
    <div class="wrapper py-16">
      <span class="stripe"><i></i><i></i><i></i></span>
      <h1 class="headline headline-l mt-6">Por aquí no hay camino</h1>
      <p class="mt-4 max-w-[34rem] text-lg text-fog">
        La página que buscas no existe o cambió de dirección. Desde el catálogo llegas a todo lo que hay en la tienda.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/catalogo" class="button">Ver el catálogo</a>
        <a href="/" class="button button-dark">Ir al inicio</a>
      </div>
    </div>
  </div>
</Base>
