---
import WorkshopForm from '../components/WorkshopForm';
import Base from '../layouts/Base.astro';
import { services } from '../lib/catalog';
import { formatPrice } from '../lib/price';
---

<Base title="Taller" description="Ajuste, mantenimiento, purga de frenos y armado de bicicletas. Pide tu cita por WhatsApp.">
  <div class="signboard">
    <div class="wrapper pb-12 pt-10 sm:pb-16 sm:pt-14">
      <h1 class="headline headline-l">Taller</h1>
      <p class="mt-4 max-w-[36rem] text-lg font-medium text-olive">
        Elige el servicio, dinos qué día te sirve y te confirmamos la hora por WhatsApp.
      </p>
    </div>
  </div>

  <div class="wrapper grid items-start gap-10 pt-12 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
    <section aria-labelledby="services-title" class="ticket px-5 pb-6 pt-6 sm:px-8 sm:pb-8">
      <h2 id="services-title" class="headline headline-m">Servicios y precios</h2>
      <ul class="mt-5 divide-y divide-rule">
        {
          services.map((s) => (
            <li class="py-4">
              <div class="flex items-baseline gap-3">
                <p class="text-lg font-semibold leading-snug">{s.name}</p>
                <span class="leader" aria-hidden="true" />
                <p class="price shrink-0 text-2xl">{formatPrice(s.price)}</p>
              </div>
              <p class="mt-1 max-w-[30rem] text-steel">{s.description}</p>
              <p class="mt-1 text-sm text-steel">Tiempo aproximado: {s.duration}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 border-t border-rule pt-4 text-steel">
        Los precios son de mano de obra. Si hay que cambiar algún repuesto, te avisamos antes de ponerlo.
      </p>
    </section>

    <WorkshopForm client:load services={services} />
  </div>
</Base>
